# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# 사용할 모델 (기본값 claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# BotFather에서 받은 텔레그램 봇 토큰 (비워 두면 텔레그램·사람 전문가 기능 꺼짐)
TELEGRAM_BOT_TOKEN=
# 관리자 페이지(/admin) 비밀번호 — 기업 계정 발급, 토큰 충전·정산, 전문가 등록 (필수)
ADMIN_PASSWORD=
# HTTPS 뒤에서 운영할 때 1로 설정 (로그인 쿠키에 Secure 적용)
COOKIE_SECURE=0
# 외부에서 접속하는 주소 (예: https://hamkkebot.example.org) — 전문가 /login 메시지에 바로가기 링크를 붙임
PUBLIC_URL=
PORT=3000
