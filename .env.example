# Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# (선택) Claude API 주소를 바꿀 때 — 사내 프록시 등. 비워 두면 https://api.anthropic.com
ANTHROPIC_BASE_URL=
# 사용할 모델 (기본값 claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5
# AI 생성 연결: anthropic(기본) 또는 openai(로컬 추론 서버 — vLLM·Ollama 등 OpenAI 호환). 웹 검색(VC 찾기)은 항상 Claude API
LLM_PROVIDER=anthropic
# openai일 때 필수: 추론 서버 주소와 모델 이름
LLM_BASE_URL=
LLM_MODEL=
# 추론 서버가 키를 요구할 때만
LLM_API_KEY=
# 웹 검색 브릿지: 비우면 Claude API web_search. searxng(자체 호스팅)·brave 로 정하면 로컬 LLM으로도 VC 찾기 가능
SEARCH_ENGINE=
# searxng 주소 (settings.yml search.formats에 json 허용)
SEARCH_BASE_URL=
# brave 구독 키
SEARCH_API_KEY=
# 본문을 가져올 상위 페이지 수 (기본 5, 0이면 검색 요약만)
SEARCH_FETCH_PAGES=
# BotFather에서 받은 텔레그램 봇 토큰 (비워 두면 텔레그램·사람 전문가 기능 꺼짐)
TELEGRAM_BOT_TOKEN=
# 관리자 페이지(/admin) 비밀번호 — 기업 계정 발급, 토큰 충전·정산, 전문가 등록 (필수)
ADMIN_PASSWORD=
# HTTPS 뒤에서 운영할 때 1로 설정 (로그인 쿠키에 Secure 적용)
COOKIE_SECURE=0
# 외부에서 접속하는 주소 (예: https://hamkkebot.example.org) — 전문가 /login 메시지에 바로가기 링크를 붙임
PUBLIC_URL=
PORT=3000
